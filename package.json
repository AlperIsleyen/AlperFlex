{
  "name": "alperflex",
  "private": true,
  "workspaces": ["apps/web", "apps/mobile"],
  "dependencies": {
    "react-native-screens": "4.30.0",
    "react-native-safe-area-context": "5.10.1"
  },
  "scripts": {
    "dev:web": "npm run dev -w @alperflex/web",
    "dev:mobile": "npm run start -w @alperflex/mobile",
    "build": "npm run build -w @alperflex/web",
    "start:local": "npm run start -w @alperflex/web -- --hostname 0.0.0.0",
    "setup:admin": "node scripts/admin.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test tests/*.test.mjs"
  }
}
